@page "/login"
@layout EmptyLayout
@using POS.Client.Providers
@using POS.Shared.DTOs
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

<div class="login-wrapper">
    <h2 class="login-title">USER LOGIN</h2>

    <div class="login-card">
        <div class="input-group">
            <div class="input-icon">
                <i class="oi oi-person"></i> <!-- Icono de usuario -->
            </div>
            <input type="email" placeholder="Email ID" @bind="email" class="input-field" />
        </div>

        <div class="input-group">
            <div class="input-icon">
                <i class="oi oi-lock-locked"></i> <!-- Icono de candado -->
            </div>
            <input type="password" placeholder="Password" @bind="password" class="input-field" />
        </div>

        <div class="options-row">
            <label class="remember-me">
                <input type="checkbox" /> Remember me
            </label>
            <a href="#" class="forgot-pass">Forgot Password?</a>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-msg">@errorMessage</div>
        }

        <button class="btn-login" @onclick="HandleLogin">LOGIN</button>

    </div>

</div>

<style>
    /* Reset básico para que ocupe toda la pantalla */
    html, body {
        height: 100%;
        margin: 0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-wrapper {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        /* Fondo con gradiente azul verdoso */
        background: linear-gradient(135deg, #1c3b46 0%, #3e7b8c 100%);
    }

    .login-title {
        color: #ffffff;
        font-weight: 300;
        letter-spacing: 3px;
        margin-bottom: 25px;
        font-size: 24px;
    }

    .login-card {
        background-color: #131c21; /* Color oscuro de la tarjeta */
        padding: 40px 30px;
        width: 320px;
        border-radius: 2px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    .input-group {
        display: flex;
        margin-bottom: 15px;
        background-color: #d1d5d8; /* Fondo gris claro del input */
        border-radius: 2px;
        overflow: hidden;
    }

    .input-icon {
        background-color: #aab0b5; /* Icono un poco más oscuro */
        color: #4a555f;
        padding: 10px 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .input-field {
        flex: 1;
        border: none;
        background: transparent;
        padding: 10px 15px;
        outline: none;
        color: #333;
        font-size: 14px;
    }

        .input-field::placeholder {
            color: #7a858c;
        }

    .options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #aab0b5;
        font-size: 12px;
        margin-bottom: 25px;
        margin-top: 10px;
    }

    .remember-me {
        display: flex;
        align-items: center;
        cursor: pointer;
        margin: 0;
    }

        .remember-me input {
            margin-right: 8px;
            accent-color: #3e7b8c;
        }

    .forgot-pass {
        color: #aab0b5;
        text-decoration: none;
    }

        .forgot-pass:hover {
            text-decoration: underline;
            color: #ffffff;
        }

    .btn-login {
        width: 100%;
        padding: 12px;
        background-color: #3e7b8c; /* Botón celeste/verdoso */
        color: white;
        border: none;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-login:hover {
            background-color: #2d5a66;
        }

    .btn-register {
        margin-top: 15px;
        width: 320px;
        padding: 15px;
        background-color: #131c21; /* Mismo color oscuro de la tarjeta */
        color: white;
        border: none;
        font-weight: 600;
        letter-spacing: 1px;
        cursor: pointer;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        transition: background 0.3s;
    }

        .btn-register:hover {
            background-color: #0d1418;
        }

    .error-msg {
        background-color: rgba(220, 53, 69, 0.2);
        color: #ff6b6b;
        padding: 8px;
        border-radius: 4px;
        font-size: 12px;
        text-align: center;
        margin-bottom: 15px;
    }
</style>

@code {
    private string email = "";
    private string password = "";
    private string errorMessage = "";

    private async Task HandleLogin()
    {
        try
        {
            errorMessage = "";
            var response = await Http.PostAsJsonAsync("api/Auth/Login", new { email, password });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AuthResponse>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    // Notificamos a Blazor que el usuario se autenticó
                    var customProvider = (CustomAuthStateProvider)AuthStateProvider;
                    await customProvider.MarkUserAsAuthenticated(result.Token);

                    // Redirigimos a la página principal
                    Navigation.NavigateTo("/");
                }
            }
            else
            {
                errorMessage = "Credenciales incorrectas o usuario no encontrado.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión con el servidor: {ex.Message}";
        }
    }

   
}