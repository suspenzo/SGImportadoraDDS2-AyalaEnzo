@page "/historial-sesiones"
@attribute [Authorize(Roles = "Administrador")]
@using POS.Shared.DTOs
@inject HttpClient Http

<h3 class="mb-4">Historial de Inicios de Sesión</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Usuario</th>
                    <th>Email</th>
                    <th>Hora de Entrada</th>
                    <th>Hora de Salida</th>
                    <th>Estado de Sesión</th>
                </tr>
            </thead>
            <tbody>
                @if (historial == null)
                {
                    <tr><td colspan="5" class="text-center py-3">Cargando historial...</td></tr>
                }
                else if (!historial.Any())
                {
                    <tr><td colspan="5" class="text-center py-3">No hay registros de sesiones.</td></tr>
                }
                else
                {
                    @foreach (var h in historial)
                    {
                        <tr>
                            <td><strong>@h.NombreUsuario</strong></td>
                            <td>@h.Email</td>
                            <td>@h.FechaEntrada.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                @if (h.FechaSalida.HasValue)
                                {
                                    @h.FechaSalida.Value.ToString("dd/MM/yyyy HH:mm:ss")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (h.FechaSalida.HasValue)
                                {
                                    <span class="badge bg-secondary">Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Activa</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private List<LoginHistoryDto>? historial;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            historial = await Http.GetFromJsonAsync<List<LoginHistoryDto>>("api/Auth/historial");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar el historial: {ex.Message}";
        }
    }
}