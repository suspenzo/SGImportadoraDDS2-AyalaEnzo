@page "/users"
@attribute [Authorize(Roles = "Administrador")] 
@using POS.Shared.DTOs
@using POS.Shared.Enums
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h3>Gestión de Usuarios</h3>

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<button class="btn btn-primary mb-3" @onclick="ShowCreateForm">Nuevo Usuario</button>

@if (showForm)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="card-title">@(isEditing ? "Editar Usuario" : "Nuevo Usuario")</h5>
            <EditForm Model="currentUser" OnValidSubmit="SaveUser">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label>Nombre Completo *</label>
                        <InputText @bind-Value="currentUser.Name" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Email *</label>
                        <InputText @bind-Value="currentUser.Email" type="email" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Contraseña @(isEditing ? "(dejar en blanco para mantener)" : "*")</label>
                        <InputText @bind-Value="currentUser.Password" type="password" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Rol</label>
                        <InputSelect @bind-Value="currentUser.Role" class="form-control">
                            <option value="@Role.Administrador">Administrador</option>
                            <option value="@Role.Vendedor">Vendedor</option>
                            @* Si tienes el rol Bodeguero, agrégalo aquí *@
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label>Estado</label>
                        <InputSelect @bind-Value="currentUser.Estado" class="form-control">
                            <option value="@Status.Activo">Activo</option>
                            <option value="@Status.Inactivo">Inactivo</option>
                        </InputSelect>
                    </div>
                </div>
                
                <button type="submit" class="btn btn-success">Guardar</button>
                <button type="button" class="btn btn-secondary ms-2" @onclick="CancelForm">Cancelar</button>
            </EditForm>
        </div>
    </div>
}

<table class="table table-striped table-hover shadow-sm">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Email</th>
            <th>Rol</th>
            <th>Fecha Creación</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (users == null)
        {
            <tr><td colspan="7" class="text-center">Cargando usuarios...</td></tr>
        }
        else if (users.Count == 0)
        {
            <tr><td colspan="7" class="text-center">No hay usuarios registrados.</td></tr>
        }
        else
        {
            @foreach (var u in users)
            {
                <tr>
                    <td>@u.Id</td>
                    <td>@u.Name</td>
                    <td>@u.Email</td>
                    <td>
                        <span class="badge @(u.Role == "Administrador" ? "bg-primary" : "bg-info text-dark")">
                            @u.Role
                        </span>
                    </td>
                    <td>@u.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        @if (u.Estado == Status.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <button class="btn btn-sm btn-warning me-1" @onclick="() => EditUser(u)">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(u.Id)">Eliminar</button>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

@code {
    private List<UserResponse>? users;
    private UserRequest currentUser = new();
    
    private bool showForm = false;
    private bool isEditing = false;
    private int editingUserId;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            errorMessage = null;
            // Endpoint que devuelve List<UserResponse>
            users = await Http.GetFromJsonAsync<List<UserResponse>>("api/Auth/usuarios");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al cargar los usuarios: {ex.Message}";
        }
    }

    private void ShowCreateForm()
    {
        currentUser = new UserRequest { Role = Role.Vendedor, Estado = Status.Activo };
        isEditing = false;
        showForm = true;
        errorMessage = null;
    }

    private void EditUser(UserResponse u)
    {
        currentUser = new UserRequest
        {
            Name = u.Name,
            Email = u.Email,
            Password = "", // Vacío para no sobreescribir la contraseña actual
            Role = Enum.Parse<Role>(u.Role), // Convertimos el string "Administrador" de vuelta al Enum
            Estado = u.Estado
        };
        
        editingUserId = u.Id;
        isEditing = true;
        showForm = true;
        errorMessage = null;
    }

    private async Task SaveUser()
    {
        try
        {
            errorMessage = null;
            HttpResponseMessage response;

            if (isEditing)
            {
                // Endpoint para actualizar (recibe UserRequest)
                response = await Http.PutAsJsonAsync($"api/Auth/{editingUserId}", currentUser);
            }
            else
            {
                // Endpoint de registro (recibe RegisterRequest). 
                // Mapeamos manualmente los campos requeridos por tu RegisterRequest.
                var registerRequest = new
                {
                    FullName = currentUser.Name, // Tu RegisterRequest usa 'FullName'
                    Email = currentUser.Email,
                    Password = currentUser.Password,
                    ConfirmPassword = currentUser.Password, // Asumimos la misma contraseña
                    Role = currentUser.Role
                };
                response = await Http.PostAsJsonAsync("api/Auth/register", registerRequest);
            }

            if (response.IsSuccessStatusCode)
            {
                showForm = false;
                await LoadData();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = $"Error al guardar: {errorContent}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error de conexión: {ex.Message}";
        }
    }

    private async Task DeleteUser(int id)
    {
        bool confirm = await JSRuntime.InvokeAsync<bool>("confirm", "¿Estás seguro de que deseas eliminar este usuario?");
        
        if (confirm)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/Auth/{id}");
                if (response.IsSuccessStatusCode)
                {
                    await LoadData();
                }
                else
                {
                    errorMessage = "No se pudo eliminar el usuario. Verifique si tiene ventas asociadas.";
                }
            }
            catch (Exception ex)
            {
                errorMessage = $"Error al eliminar: {ex.Message}";
            }
        }
    }

    private void CancelForm()
    {
        showForm = false;
        errorMessage = null;
    }
}